---
import { site, socials } from "../data/site";

const links = [
  { label: "work", href: "#work" },
  { label: "blog", href: "#blog" },
  { label: "playground", href: "#playground" },
  { label: "archive", href: "#archive" },
];
---

<nav class="nav mono" data-nav>
  <div class="left">
    <a href="#top" class="brand" aria-label={`${site.short}, back to top`}>
      <svg viewBox="0 0 40 40" aria-hidden="true">
        <!-- Flag, planted -->
        <path class="pole" d="M30 3.5v33" />
        <path class="flag" d="M30.6 4.2c2.6-1.3 4.6 1.2 8 0v6.6c-3.4 1.2-5.4-1.3-8 0Z" />
        <!-- Backpack -->
        <rect class="line" x="5.6" y="16.4" width="4.4" height="9.4" rx="1.6" />
        <!-- Suit -->
        <rect class="line" x="9.6" y="15.8" width="12.4" height="11.6" rx="4.2" />
        <rect class="panel" x="13.2" y="19" width="4.4" height="3" rx="1" />
        <!-- Arms: one gripping the pole, one at the side -->
        <path class="line" d="M21.4 18.6l4.2-2 3.6-.2" />
        <circle class="hand" cx="29.6" cy="16.4" r="1.4" />
        <path class="line" d="M10.8 19.2l-.6 5.8" />
        <!-- Legs and boots -->
        <path class="line" d="M13.4 27.4v6.2h-3M18.4 27.4v6.2h3" />
        <!-- Helmet with visor and glint -->
        <circle class="line helmet" cx="15.8" cy="9.6" r="6.2" />
        <rect class="visor" x="11.6" y="7" width="9.2" height="5.6" rx="2.8" />
        <path class="glint" d="M13.4 9.2c.4-.6 1-.9 1.8-1" />
      </svg>
    </a>
    {links.map((l) => <a href={l.href}>{l.label}</a>)}
  </div>
  <div class="theme" role="group" aria-label="Colour theme">
    <button type="button" data-set-theme="light">light</button>
    <span aria-hidden="true">/</span>
    <button type="button" data-set-theme="dark">dark</button>
  </div>
  <div class="right">
    {
      socials.map((s) => (
        <a
          class="icon"
          href={s.href}
          target={s.href.startsWith("http") ? "_blank" : undefined}
          rel="noopener noreferrer"
          aria-label={s.label}
          title={s.label}
        >
          {s.label === "github" && (
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                fill="currentColor"
                d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
              />
            </svg>
          )}
          {s.label === "linkedin" && (
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                fill="currentColor"
                d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.125 2.062 2.062 0 0 1 0 4.125zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
              />
            </svg>
          )}
          {s.label === "substack" && (
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                fill="currentColor"
                d="M22.539 8.242H1.46V5.406h21.08v2.836zM1.46 10.812V24L12 18.11 22.54 24V10.812H1.46zM22.54 0H1.46v2.836h21.08V0z"
              />
            </svg>
          )}
          {s.label === "email" && (
            <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="4" width="20" height="16" rx="2" />
              <path d="m22 7-10 6L2 7" />
            </svg>
          )}
        </a>
      ))
    }
  </div>
</nav>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 52px;
    padding: 0 var(--gutter);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    transition: background-color 0.3s, border-color 0.3s;
    border-bottom: 1px solid transparent;
  }
  .nav.scrolled {
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom-color: var(--line);
  }
  a,
  button {
    color: var(--muted);
    text-decoration: none;
    transition: color 0.15s;
  }
  a:hover,
  button:hover,
  a:focus-visible,
  button:focus-visible {
    color: var(--fg);
    outline: none;
  }
  .left,
  .right {
    display: flex;
    gap: 20px;
    align-items: center;
  }
  .right {
    justify-content: flex-end;
    gap: 18px;
  }
  .icon {
    display: grid;
    place-items: center;
    padding: 4px;
    color: color-mix(in srgb, var(--fg) 88%, transparent);
  }
  .icon:hover,
  .icon:focus-visible {
    color: var(--accent);
  }
  .icon svg {
    width: 20px;
    height: 20px;
  }
  .brand {
    display: grid;
    place-items: center;
    color: var(--fg);
    margin-right: 6px;
  }
  /* Astronaut planting a flag: outlined suit, solid visor, orange flag. */
  .brand svg {
    width: 38px;
    height: 38px;
    overflow: visible;
  }
  .line,
  .pole {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .helmet {
    fill: var(--bg);
  }
  .visor,
  .hand,
  .panel {
    fill: currentColor;
  }
  .glint {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.6;
    stroke-linecap: round;
  }
  .flag {
    fill: var(--accent);
    transform-origin: 30px 7px;
    animation: wave 2.4s ease-in-out infinite;
  }
  .brand:hover .flag {
    animation-duration: 0.8s;
  }
  @keyframes wave {
    50% {
      transform: skewY(-6deg) scaleX(0.92);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .flag {
      animation: none;
    }
  }
  .theme {
    display: flex;
    gap: 6px;
    color: var(--faint);
  }
  button {
    font: inherit;
    text-transform: inherit;
    letter-spacing: inherit;
    background: none;
    border: 0;
    padding: 4px 2px;
    cursor: pointer;
    color: var(--faint);
  }
  :global(:root[data-theme="dark"]) [data-set-theme="dark"],
  :global(:root[data-theme="light"]) [data-set-theme="light"] {
    color: var(--fg);
  }
  @media (max-width: 760px) {
    .left a:not(.brand),
    .right {
      display: none;
    }
    .nav {
      grid-template-columns: 1fr auto;
    }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>("[data-nav]")!;
  const onScroll = () => nav.classList.toggle("scrolled", window.scrollY > window.innerHeight * 0.6);
  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll();

  document.querySelectorAll<HTMLButtonElement>("[data-set-theme]").forEach((btn) =>
    btn.addEventListener("click", () => {
      const theme = btn.dataset.setTheme!;
      document.documentElement.dataset.theme = theme;
      try {
        localStorage.setItem("theme", theme);
      } catch {}
      window.dispatchEvent(new CustomEvent("themechange"));
    }),
  );
</script>

---
import { featured, site, tech } from "../data/site";
import { asciiCover } from "../lib/ascii-cover";
import Starfield from "./Starfield.astro";
---

<section class="section has-starfield" id="work" style="--dot: var(--blue)">
  <Starfield stats hint="click the empty space to warp" />

  <aside class="section-aside">
    <h2 class="section-label">Featured Projects</h2>
    <p class="section-blurb">
      Picks across backend, infrastructure and tooling. The ones where I got to stretch a little, and the ones I
      explain to family when they ask what exactly I do.
    </p>
  </aside>

  <div class="grid">
    {
      featured.map((p) => {
        const Tag = p.href ? "a" : "div";
        return (
          <Tag
            class="card"
            href={p.href}
            target={p.href?.startsWith("http") ? "_blank" : undefined}
            rel={p.href ? "noopener noreferrer" : undefined}
            tabindex={p.href ? undefined : 0}
            title={p.blurb}
            style={`--card-accent: ${p.accent}`}
          >
            <div class="media">
              {p.image ? (
                <img src={p.image} alt={`${p.name} screenshot`} loading="lazy" decoding="async" />
              ) : (
                <pre class="ascii mono" aria-hidden="true">{asciiCover(p.name)}</pre>
              )}
              {p.wip && <span class="wip mono">{site.short}'s still writing</span>}
            </div>
            <div class="details">
              <div class="identity">
                <h3>{p.name}</h3>
                <span class="muted">© {p.year}</span>
                {p.href && <span class="muted arrow">↗</span>}
              </div>
              <ul class="stack" aria-label={`Built with ${p.stack.map((t) => tech[t].label).join(", ")}`}>
                {p.stack.map((t) => (
                  <li title={tech[t].label} style={`--icon: url(${tech[t].icon})`} />
                ))}
              </ul>
            </div>
          </Tag>
        );
      })
    }
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }
  /*
   * After aj's featured cards: the media fills the card, and on hover it
   * shrinks to make room for a details row that fades up underneath.
   */
  .card {
    --details-height: 18px;
    --details-space: 0px;
    position: relative;
    display: block;
    aspect-ratio: 16 / 10.6;
    color: inherit;
    text-decoration: none;
    outline: none;
  }
  .card:hover,
  .card:focus-visible {
    --details-space: calc(var(--details-height) + 14px);
  }
  .media {
    position: absolute;
    inset: 0 0 auto;
    height: calc(100% - var(--details-space));
    border-radius: 8px;
    overflow: hidden;
    background: var(--card);
    container-type: size;
    display: grid;
    place-items: center;
    transition: height 0.36s cubic-bezier(0.2, 0, 0, 1);
  }
  .media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
  }
  .ascii {
    margin: 0;
    /* Fit 72 columns x 30 rows: Geist Mono advance is 0.6em, line-height 1.15. */
    font-size: min(calc(100cqw / 72 / 0.6), calc(92cqh / 30 / 1.15));
    line-height: 1.15;
    color: var(--card-accent);
  }
  .details {
    position: absolute;
    inset: auto 0 0;
    height: var(--details-height);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 0 2px;
    font-size: 14px;
    white-space: nowrap;
    opacity: 0;
    transform: translateY(-6px);
    pointer-events: none;
    transition:
      opacity 0.3s cubic-bezier(0.2, 0, 0, 1),
      transform 0.36s cubic-bezier(0.2, 0, 0, 1);
  }
  .card:hover .details,
  .card:focus-visible .details {
    opacity: 1;
    transform: none;
  }
  .identity {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }
  h3 {
    margin: 0;
    font: inherit;
    font-weight: 500;
  }
  .muted {
    opacity: 0.6;
  }
  .arrow {
    margin-left: -2px;
  }
  .stack {
    display: flex;
    gap: 9px;
    margin: 0;
    padding: 0;
    list-style: none;
    flex-shrink: 0;
  }
  .stack li {
    width: 15px;
    height: 15px;
    background: var(--fg);
    opacity: 0.7;
    mask: var(--icon) center / contain no-repeat;
    -webkit-mask: var(--icon) center / contain no-repeat;
    pointer-events: auto;
  }
  .card:focus-visible::after {
    content: "";
    position: absolute;
    inset: -4px;
    border: 2px solid var(--fg);
    border-radius: 12px;
    pointer-events: none;
  }
  .wip {
    position: absolute;
    top: 12px;
    left: 12px;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 4px 8px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--bg) 75%, transparent);
    color: var(--muted);
    border: 1px solid var(--line);
  }
  /* No hover on touch screens, so the details row is always shown. */
  @media (hover: none) {
    .card {
      --details-space: calc(var(--details-height) + 14px);
    }
    .details {
      opacity: 1;
      transform: none;
    }
  }
  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .media,
    .details {
      transition: none;
    }
  }
</style>

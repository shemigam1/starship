---
import { featured, site } from "../data/site";
import { asciiCover } from "../lib/ascii-cover";
---

<section class="section" id="work" style="--dot: var(--blue)">
  <aside class="section-aside">
    <h2 class="section-label">Featured Projects</h2>
    <p class="section-blurb">
      Picks across backend, infrastructure and tooling. The ones where I got to stretch a little, and the ones I
      explain to family when they ask what exactly I do.
    </p>
  </aside>

  <div class="grid">
    {
      featured.map((p) => {
        const Tag = p.href ? "a" : "div";
        return (
          <Tag
            class="card"
            href={p.href}
            target={p.href?.startsWith("http") ? "_blank" : undefined}
            rel={p.href ? "noopener noreferrer" : undefined}
            style={`--card-accent: ${p.accent}`}
          >
            <div class="cover">
              {p.image ? (
                <img src={p.image} alt="" loading="lazy" />
              ) : (
                <pre class="ascii mono" aria-hidden="true">{asciiCover(p.name)}</pre>
              )}
              <p class="blurb">{p.blurb}</p>
              {p.wip && <span class="wip mono">{site.short}'s still writing</span>}
            </div>
            <div class="meta">
              <h3>
                {p.name}
                {p.href && <span class="arrow">↗</span>}
              </h3>
              <span class="mono year">© {p.year}</span>
              <span class="disc">{p.discipline}</span>
            </div>
          </Tag>
        );
      })
    }
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    color: inherit;
    text-decoration: none;
    padding-bottom: 20px;
  }
  .cover {
    position: relative;
    aspect-ratio: 4 / 3.2;
    border-radius: 6px;
    overflow: hidden;
    background: var(--card);
    container-type: inline-size;
    display: grid;
    place-items: center;
  }
  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ascii {
    margin: 0;
    /* 72 columns across the card: Geist Mono advance is 0.6em. */
    font-size: calc(100cqw / 72 / 0.6);
    line-height: 1.15;
    color: var(--card-accent);
    transition: transform 0.7s var(--ease), opacity 0.4s;
  }
  .blurb {
    position: absolute;
    inset: auto 0 0 0;
    margin: 0;
    padding: 20px;
    font-size: 13px;
    line-height: 1.5;
    color: var(--fg);
    background: linear-gradient(to top, var(--card) 55%, transparent);
    padding-top: 48px;
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.35s var(--ease), transform 0.45s var(--ease);
  }
  .card:hover .ascii,
  .card:focus-visible .ascii {
    transform: scale(1.06);
  }
  .card:hover .blurb,
  .card:focus-visible .blurb {
    opacity: 1;
    transform: none;
  }
  .card:focus-visible {
    outline: 1px solid var(--fg);
    outline-offset: 4px;
    border-radius: 6px;
  }
  .wip {
    position: absolute;
    top: 12px;
    left: 12px;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 4px 8px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--bg) 75%, transparent);
    color: var(--muted);
    border: 1px solid var(--line);
  }
  .meta {
    display: grid;
    grid-template-columns: 1fr auto;
    row-gap: 2px;
    padding: 0 2px;
  }
  h3 {
    margin: 0;
    font-size: 14px;
    font-weight: 500;
  }
  .arrow {
    margin-left: 6px;
    color: var(--faint);
    transition: color 0.15s;
  }
  .card:hover .arrow {
    color: var(--fg);
  }
  .year {
    font-size: 11px;
    color: var(--faint);
    align-self: center;
  }
  .disc {
    font-size: 13px;
    color: var(--muted);
  }
  /* Touch screens can't hover, so show the blurb under the cover instead. */
  @media (hover: none) {
    .blurb {
      position: static;
      opacity: 1;
      transform: none;
      background: none;
      padding: 12px 2px 0;
      order: 2;
      color: var(--muted);
    }
    .cover {
      display: flex;
      flex-direction: column;
      aspect-ratio: auto;
      background: none;
      overflow: visible;
    }
    .ascii {
      background: var(--card);
      border-radius: 6px;
      width: 100%;
      padding: 8% 0;
      text-align: center;
    }
  }
  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>

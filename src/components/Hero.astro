---
import { bio, site, socials } from "../data/site";
---

<header class="hero" id="top">
  <img
    class="painting"
    src="/hero/creation-of-adam.webp"
    srcset="/hero/creation-of-adam-960.webp 960w, /hero/creation-of-adam.webp 1920w"
    sizes="100vw"
    alt="Michelangelo's The Creation of Adam: God reaching out to touch Adam's hand"
    fetchpriority="high"
  />
  <div class="shade" aria-hidden="true"></div>

  <div class="copy">
    <blockquote class="quote mono" aria-label={site.quote.join(" ")}>
      <span data-typed aria-hidden="true"></span><span class="cursor" aria-hidden="true"></span>
    </blockquote>

    <div class="bio mono">
      {
        bio.map((line) => (
          <p>
            {line.map((part) =>
              typeof part === "string" ? (
                part
              ) : part.href ? (
                <a
                  class="link"
                  href={part.href}
                  target={part.href.startsWith("http") ? "_blank" : undefined}
                  rel="noopener noreferrer"
                >
                  {part.label}
                </a>
              ) : (
                part.label
              ),
            )}
          </p>
        ))
      }
    </div>

    <p class="socials mono">
      {
        socials.map((s, i) => (
          <>
            {i > 0 && <span class="sep"> / </span>}
            <a class="link" href={s.href} target={s.href.startsWith("http") ? "_blank" : undefined} rel="noopener noreferrer">
              {s.label}
            </a>
          </>
        ))
      }
    </p>
  </div>

  <p class="credit mono">Michelangelo, <i>The Creation of Adam</i>, c. 1512</p>
</header>

<style>
  .hero {
    position: relative;
    height: 100svh;
    min-height: 560px;
    overflow: hidden;
  }
  /* The fresco fills the hero, framed on the hands. */
  /*
   * The fresco is sized past the hero and anchored on the point where the two
   * fingers meet (38.5% across, 45% down the painting), so the touch always
   * lands at the horizontal centre.
   */
  .painting {
    --hero-h: max(100svh, 560px);
    position: absolute;
    left: 50%;
    top: 40%;
    width: max(135%, calc(var(--hero-h) * 2.204 * 1.12));
    max-width: none;
    height: auto;
    transform: translate(-38.5%, -45%);
  }
  /* Fades the painting into the page so the nav and copy stay legible. */
  .shade {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(to bottom, color-mix(in srgb, var(--bg) 75%, transparent), transparent 16%),
      linear-gradient(to top, var(--bg) 4%, color-mix(in srgb, var(--bg) 88%, transparent) 34%, color-mix(in srgb, var(--bg) 25%, transparent) 62%, transparent 80%),
      linear-gradient(to right, color-mix(in srgb, var(--bg) 55%, transparent), transparent 45%);
  }
  .copy {
    position: absolute;
    left: clamp(var(--gutter), 11vw, 180px);
    right: var(--gutter);
    bottom: clamp(48px, 12vh, 128px);
    display: flex;
    flex-direction: column;
    gap: 36px;
    max-width: 700px;
    pointer-events: none;
  }
  .copy a {
    pointer-events: auto;
  }
  .quote {
    margin: 0;
    min-height: 3.4em;
    font-size: 14px;
    line-height: 1.7;
    letter-spacing: 0.02em;
    color: var(--muted);
    white-space: pre-line;
  }
  .cursor {
    display: inline-block;
    width: 0.55em;
    height: 1em;
    margin-left: 4px;
    transform: translateY(0.15em);
    background: var(--fg);
    animation: blink 1.05s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .bio {
    font-size: 14px;
    line-height: 1.75;
  }
  .bio p {
    margin: 0 0 1.1em;
  }
  .bio p:last-child {
    margin-bottom: 0;
  }
  .socials {
    margin: 0;
    font-size: 13px;
  }
  .socials a {
    opacity: 0.6;
  }
  .socials a:hover {
    opacity: 1;
  }
  .sep {
    opacity: 0.4;
  }
  .credit {
    position: absolute;
    right: var(--gutter);
    bottom: 24px;
    margin: 0;
    font-size: 11px;
    color: var(--faint);
  }
  @media (max-width: 760px) {
    .copy {
      bottom: 64px;
      gap: 24px;
    }
    .bio,
    .quote {
      font-size: 13px;
    }
    /* Portrait screens: keep the painting in the top half so the hands sit above the copy. */
    .painting {
      top: 27%;
      width: calc(var(--hero-h) * 0.6 * 2.204);
      mask-image: linear-gradient(to bottom, #000 64%, transparent 92%);
      -webkit-mask-image: linear-gradient(to bottom, #000 64%, transparent 92%);
    }
    .credit {
      left: var(--gutter);
      right: auto;
    }
  }
</style>

<script>
  import { site } from "../data/site";

  // Typewriter for the quote.
  const typed = document.querySelector<HTMLElement>("[data-typed]")!;
  const text = site.quote.join("\n");
  if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
    typed.textContent = text;
  } else {
    let i = 0;
    const type = () => {
      typed.textContent = text.slice(0, ++i);
      if (i < text.length) setTimeout(type, text[i - 1] === "\n" ? 420 : 38 + Math.random() * 50);
    };
    setTimeout(type, 600);
  }
</script>

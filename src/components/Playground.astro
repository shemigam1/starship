---
const art = [
  "  .        *               .         +    ",
  "      +          __                       ",
  "             ___/  \\___         .         ",
  "  .     ====[   ....   ]====>         *   ",
  "             ---\\__/---                   ",
  "     *                    .        .      ",
];
---

<section class="section" id="playground" style="--dot: var(--pink)">
  <aside class="section-aside">
    <h2 class="section-label">Playground</h2>
    <p class="section-blurb">
      A home for experiments, prototypes, tiny tools, and the occasional "I wonder if I can build that."
    </p>
  </aside>

  <div class="soon">
    <pre class="art mono" aria-hidden="true">{art.join("\n")}</pre>
    <p class="title mono">coming soon<span class="cursor" aria-hidden="true"></span></p>
    <p class="sub">The experiments are still in the hangar. Check back soon.</p>
  </div>
</section>

<style>
  .soon {
    --tone: var(--pink);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    max-width: 980px;
    min-height: 300px;
    padding: 48px 24px;
    border-radius: 6px;
    border-top: 2px solid var(--tone);
    text-align: center;
    background:
      repeating-linear-gradient(0deg, transparent 0 23px, color-mix(in srgb, var(--tone) 18%, transparent) 23px 24px),
      repeating-linear-gradient(90deg, transparent 0 23px, color-mix(in srgb, var(--tone) 18%, transparent) 23px 24px),
      color-mix(in srgb, var(--tone) 9%, var(--card));
  }
  .art {
    margin: 0 0 8px;
    font-size: clamp(10px, 1.3vw, 16px);
    line-height: 1.25;
    font-weight: 600;
    color: var(--tone);
    animation: drift 6s ease-in-out infinite;
  }
  @keyframes drift {
    50% {
      transform: translateX(10px);
    }
  }
  .title {
    margin: 0;
    font-size: clamp(22px, 3vw, 34px);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--fg);
  }
  .cursor {
    display: inline-block;
    width: 0.55em;
    height: 0.9em;
    margin-left: 6px;
    transform: translateY(0.1em);
    background: var(--tone);
    animation: blink 1.05s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .sub {
    margin: 0;
    font-size: 13px;
    color: var(--muted);
  }
  @media (max-width: 640px) {
    .soon {
      min-height: 240px;
    }
    .art {
      font-size: 8px;
    }
  }
</style>

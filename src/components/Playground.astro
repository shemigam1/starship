---
import { playground } from "../data/site";
---

<section class="section" id="playground" style="--dot: var(--pink)">
  <aside class="section-aside">
    <h2 class="section-label">Playground</h2>
    <p class="section-blurb">
      A home for experiments, prototypes, tiny tools, and the occasional "I wonder if I can build that."
    </p>
  </aside>

  <div class="items">
    {
      playground.map((p, i) => (
        <article class="item">
          <a class="art" href={p.href} style={`--tone: var(${i % 2 ? "--pink" : "--accent"})`} aria-label={p.cta}>
            <pre class="mono" aria-hidden="true">{p.art.join("\n")}</pre>
          </a>
          <h3>{p.name}</h3>
          <p>{p.blurb}</p>
          <a class="cta mono" href={p.href}>
            {p.cta} <span aria-hidden="true">↗</span>
          </a>
        </article>
      ))
    }
  </div>
</section>

<style>
  .items {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px 24px;
    max-width: 980px;
  }
  .item {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .art {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10;
    margin-bottom: 8px;
    border-radius: 6px;
    background:
      repeating-linear-gradient(0deg, transparent 0 23px, color-mix(in srgb, var(--tone) 18%, transparent) 23px 24px),
      repeating-linear-gradient(90deg, transparent 0 23px, color-mix(in srgb, var(--tone) 18%, transparent) 23px 24px),
      color-mix(in srgb, var(--tone) 9%, var(--card));
    border-top: 2px solid var(--tone);
    color: var(--tone);
    text-decoration: none;
    overflow: hidden;
  }
  pre {
    margin: 0;
    font-size: clamp(11px, 1.7vw, 22px);
    line-height: 1.25;
    font-weight: 600;
    transition: transform 0.6s var(--ease);
  }
  .art:hover pre {
    transform: scale(1.08) rotate(-1.5deg);
  }
  h3 {
    margin: 0;
    font-size: 14px;
    font-weight: 500;
  }
  p {
    margin: 0;
    font-size: 13px;
    color: var(--muted);
    max-width: 46ch;
  }
  .cta {
    font-size: 12px;
    font-weight: 500;
    color: var(--fg);
    text-decoration: none;
    margin-top: 4px;
  }
  .cta span {
    display: inline-block;
    transition: transform 0.2s var(--ease);
  }
  .cta:hover span {
    transform: translate(2px, -2px);
  }
  @media (max-width: 640px) {
    .items {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    pre {
      font-size: 12px;
    }
  }
</style>
